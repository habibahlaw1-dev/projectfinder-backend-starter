{
  "info": {
    "name": "ProjectFinder Backend API",
    "description": "Starter API collection for PNA 1 ProjectFinder.com MVP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "projectId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "deliverableId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Test User\",\"email\":\"user@example.com\",\"password\":\"Password123!\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@example.com\",\"password\":\"AdminPassword123!\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/projects"
          }
        },
        {
          "name": "Filter by industry",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/projects?industry=Healthcare"
          }
        },
        {
          "name": "Filter by difficulty",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/projects?difficulty=INTERMEDIATE"
          }
        },
        {
          "name": "Get project",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"
          }
        },
        {
          "name": "Start project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/start"
          }
        },
        {
          "name": "Create project (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Sample Project\",\"description\":\"Sample description\",\"companyName\":\"Example Co\",\"scenario\":\"Sample scenario\",\"businessProblem\":\"Sample problem\",\"objective\":\"Sample objective\",\"context\":\"Sample context\",\"userRole\":\"Project Manager\",\"difficulty\":\"BEGINNER\",\"industryId\":\"REPLACE_WITH_INDUSTRY_UUID\"}"
            },
            "url": "{{baseUrl}}/api/v1/projects"
          }
        },
        {
          "name": "Publish project (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/publish"
          }
        },
        {
          "name": "Unpublish project (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/unpublish"
          }
        }
      ]
    },
    {
      "name": "Submission",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/deliverables/{{deliverableId}}/submissions"
      }
    }
  ]
}