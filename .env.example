# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL / Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projectfinder?schema=public"

# JWT - replace in real environments
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10